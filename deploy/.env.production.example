# ==========================================================================
#  ค่า .env สำหรับ production (Docker) — คัดลอกไปวางที่
#  /opt/espa/apps/line-workflow/.env  บนเซิร์ฟเวอร์ แล้วเติมค่าที่ยังว่าง
#
#  ห้าม commit ไฟล์ที่เติมค่าจริงแล้วขึ้น git
#  สิทธิ์ไฟล์บนเซิร์ฟเวอร์:  chmod 600 .env
#
#  หมายเหตุ: docker-compose.prod.yml จะ "ทับ" ค่าบางตัวให้เอง ได้แก่
#    NODE_ENV, TZ, PORT, DATABASE_URL, MEDIA_LOCAL_DIR
#  จึงไม่ต้องตั้งเองในไฟล์นี้
# ==========================================================================

# ---------- 1) ฐานข้อมูล ----------
# ใช้ตัวนี้ตัวเดียว — compose จะเอาไปประกอบเป็น DATABASE_URL
# และส่งให้ container postgres ใช้ตั้งรหัสผ่านตอนสร้างครั้งแรก
# สร้างด้วย:  openssl rand -base64 32
# !! ถ้าเปลี่ยนค่านี้หลังสร้าง volume แล้ว ฐานข้อมูลเดิมจะเข้าไม่ได้
POSTGRES_PASSWORD=

PG_POOL_MAX=10

# ---------- 2) LINE ----------
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=
# production ต้องเป็น false เท่านั้น ไม่งั้นแอปจะไม่ยิง LINE จริง
MOCK_LINE=false
DEFAULT_GROUP_ID=

# ---------- 3) Admin Dashboard ----------
ADMIN_USERNAME=
# ห้ามใช้รหัสผ่านแบบข้อความธรรมดาบน production — ปล่อย ADMIN_PASSWORD ว่างไว้
# สร้าง hash ด้วย:  npm run hash-password   (รันในเครื่องตัวเอง แล้วเอาผลมาวาง)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# สร้างด้วย:  openssl rand -base64 48
SESSION_SECRET=

# ---------- 4) AI สรุปบทสนทนา ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- 5) Capstone ----------
ANOMALY_AMOUNT_THRESHOLD=300000

# ---------- 6) เก็บไฟล์จากไลน์ ----------
MEDIA_ARCHIVE_ENABLED=true
MEDIA_STORAGE_DRIVER=local
MEDIA_MAX_SIZE_MB=25
MEDIA_TYPES=image,video,audio,file
MEDIA_SAVE_PREVIEW=true

# ---------- 7) ตัวตั้งเวลา ----------
# container รันค้างตลอด ใช้ตัวตั้งเวลาในแอปได้เลย ไม่ต้องพึ่ง cron บน host
# เงื่อนไข: ต้องมีแค่ 1 container เท่านั้น ไม่งั้นงานจะรันซ้ำ
ENABLE_SCHEDULER=true
SUMMARY_CRON=0 18 * * *
REPORT_CRON=0 8 * * *
