<%- include('partials/head') %>
<%- include('partials/nav') %>

<% if (mockLine) { %>
<div class="rounded-xl bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
  ระบบอยู่ในโหมด <strong>MOCK</strong> ข้อความจะถูกบันทึกลง log แต่ยังไม่ยิงเข้า LINE จริง
  เมื่อพร้อมส่งจริงให้ตั้ง <code class="bg-white px-1 rounded">MOCK_LINE=false</code> และใส่ CHANNEL_ACCESS_TOKEN ในไฟล์ .env
</div>
<% } %>

<div class="grid lg:grid-cols-2 gap-4">
  <form method="post" action="/send" class="card p-5 space-y-4">
    <div class="card-title">ประกอบข้อความ</div>

    <div class="grid md:grid-cols-2 gap-3">
      <div>
        <label class="label">ปลายทาง</label>
        <select name="targetType" class="input" id="targetType">
          <option value="group" <%= form.targetType === 'group' || !form.targetType ? 'selected' : '' %>>ไลน์กลุ่ม</option>
          <option value="user" <%= form.targetType === 'user' ? 'selected' : '' %>>ผู้ใช้รายบุคคล (userId)</option>
          <option value="broadcast" <%= form.targetType === 'broadcast' ? 'selected' : '' %>>Broadcast ถึงผู้ติดตาม OA ทุกคน</option>
        </select>
      </div>
      <div>
        <label class="label">เลือกกลุ่ม / ใส่ ID ปลายทาง</label>
        <select name="targetId" class="input" id="targetSelect">
          <option value="">-- เลือกกลุ่ม --</option>
          <% groups.forEach(function (g) { %>
            <option value="<%= g.group_id %>" <%= (form.targetId || selectedGroup) === g.group_id ? 'selected' : '' %>>
              <%= g.group_name || g.group_id %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>

    <div>
      <label class="label">ชนิดข้อความ</label>
      <div class="flex gap-4 text-sm">
        <label class="flex items-center gap-2">
          <input type="radio" name="kind" value="text" <%= form.kind !== 'flex' ? 'checked' : '' %> onchange="toggleKind()"> ข้อความธรรมดา
        </label>
        <label class="flex items-center gap-2">
          <input type="radio" name="kind" value="flex" <%= form.kind === 'flex' ? 'checked' : '' %> onchange="toggleKind()"> Flex Message
        </label>
      </div>
    </div>

    <!-- text -->
    <div id="blockText" class="<%= form.kind === 'flex' ? 'hidden' : '' %>">
      <label class="label">เนื้อความ</label>
      <textarea name="text" rows="6" class="input" placeholder="เช่น แจ้งประชุมทีมปฏิบัติการ วันจันทร์ 9:00 น. ห้องประชุมชั้น 3"><%= form.text || '' %></textarea>
    </div>

    <!-- flex -->
    <div id="blockFlex" class="space-y-3 <%= form.kind === 'flex' ? '' : 'hidden' %>">
      <div>
        <label class="label">วิธีสร้าง Flex</label>
        <select name="flexMode" class="input" id="flexMode" onchange="toggleFlexMode()">
          <option value="template" <%= (!form.flexMode || form.flexMode === 'template') ? 'selected' : '' %>>ใช้เทมเพลตประกาศภายในองค์กร</option>
          <option value="espa" <%= form.flexMode === 'espa' ? 'selected' : '' %>>ESPA เทมเพลตแยกแผนก</option>
          <option value="raw" <%= form.flexMode === 'raw' ? 'selected' : '' %>>วาง JSON เอง (จาก Flex Simulator)</option>
        </select>
      </div>

      <!-- ESPA: เทมเพลตแยกตามแผนก (โฟลเดอร์ espa-line-flex-templates) -->
      <div id="blockEspa" class="space-y-3 <%= form.flexMode === 'espa' ? '' : 'hidden' %>">
        <% if (!espaTemplates || espaTemplates.length === 0) { %>
          <div class="rounded-xl bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
            ไม่พบไฟล์เทมเพลตในโฟลเดอร์ <code class="bg-white px-1 rounded">espa-line-flex-templates</code>
            ตรวจว่าโฟลเดอร์อยู่ระดับเดียวกับ <code class="bg-white px-1 rounded">line-workflow-app</code>
            หรือกำหนด <code class="bg-white px-1 rounded">ESPA_TEMPLATES_DIR</code> ใน .env
          </div>
        <% } else { %>
        <div class="grid md:grid-cols-2 gap-3">
          <div>
            <label class="label">แผนก</label>
            <select name="espaDept" id="espaDept" class="input">
              <% espaTemplates.forEach(function (t) { %>
                <option value="<%= t.key %>" <%= form.espaDept === t.key ? 'selected' : '' %>><%= t.label %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="label">งานที่ทำบ่อย (เลือกแล้วเติมให้ แก้ต่อได้)</label>
            <select id="espaPreset" class="input">
              <option value="">— เลือกเพื่อเติมข้อความให้อัตโนมัติ —</option>
            </select>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-3">
          <div>
            <label class="label">หัวข้อ (TITLE)</label>
            <input name="espaTitle" id="espaTitle" value="<%= form.espaTitle || '' %>" class="input" placeholder="เช่น ผลทดลองฉีด T1 ผ่านเกณฑ์">
          </div>
          <div>
            <label class="label">altText (ข้อความสำรอง)</label>
            <input name="espaAltText" id="espaAltText" value="<%= form.espaAltText || '' %>" class="input" placeholder="เว้นว่าง = ใช้หัวข้อเป็นข้อความสำรอง">
          </div>
        </div>
        <div>
          <label class="label">รายละเอียด (MESSAGE)</label>
          <textarea name="espaMessage" id="espaMessage" rows="2" class="input" placeholder="รายละเอียดที่ต้องการแจ้ง"><%= form.espaMessage || '' %></textarea>
        </div>
        <div class="grid md:grid-cols-3 gap-3">
          <div>
            <label class="label">เลขอ้างอิง</label>
            <div class="flex gap-2">
              <input name="espaRef" id="espaRef" value="<%= form.espaRef || '' %>" class="input flex-1" placeholder="เว้นว่าง = ออกเลขให้ตอนส่ง">
              <button type="button" id="btnNextRef" class="shrink-0 px-3 rounded-lg border border-slate-300 text-sm text-slate-600 hover:bg-slate-50" title="ออกเลขเดี๋ยวนี้ (เลขจะถูกใช้ไปแม้ไม่ได้ส่ง)">ออกเลข</button>
            </div>
            <p class="text-[11px] text-slate-400 mt-1" id="refHint"></p>
          </div>
          <div>
            <label class="label">สถานะ</label>
            <input name="espaStatus" id="espaStatus" value="<%= form.espaStatus || '' %>" class="input" placeholder="เช่น ผ่าน T1">
          </div>
          <div>
            <label class="label">วันที่/เวลา</label>
            <input name="espaDatetime" id="espaDatetime" value="<%= form.espaDatetime || '' %>" class="input" placeholder="เว้นว่าง = ไม่แสดงแถวนี้">
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-3">
          <div>
            <label class="label">ผู้รับผิดชอบ</label>
            <input name="espaOwner" id="espaOwner" value="<%= form.espaOwner || '' %>" class="input" placeholder="เช่น หัวหน้ากะ B">
          </div>
          <div>
            <label class="label">หมายเหตุ (ไม่ใส่ก็ได้)</label>
            <input name="espaNote" id="espaNote" value="<%= form.espaNote || '' %>" class="input" placeholder="เว้นว่าง = ไม่แสดงกล่องหมายเหตุ">
          </div>
        </div>
        <div>
          <label class="label">รูป Hero (URL https, เว้นว่าง = ไม่แสดงรูป)</label>
          <input name="espaHeroUrl" value="<%= form.espaHeroUrl || '' %>" class="input" placeholder="https://example.com/images/hr.jpg">
        </div>
        <div class="grid md:grid-cols-2 gap-3">
          <div>
            <label class="label">ลิงก์ปุ่มหลัก (เว้นว่าง = ซ่อนปุ่ม)</label>
            <input name="espaPrimaryUrl" value="<%= form.espaPrimaryUrl || '' %>" class="input" placeholder="https://intranet.example.com/hr/125">
          </div>
          <div>
            <label class="label">ลิงก์ปุ่มรอง (เว้นว่าง = ซ่อนปุ่ม)</label>
            <input name="espaSecondaryUrl" value="<%= form.espaSecondaryUrl || '' %>" class="input" placeholder="https://intranet.example.com/contact/hr">
          </div>
        </div>
        <p class="text-[11px] text-slate-400">
          หัวสี/โลโก้แผนกมาจากไฟล์เทมเพลตของแต่ละแผนกในโฟลเดอร์ <code>espa-line-flex-templates</code>
        </p>
        <% } %>
      </div>

      <div id="blockTemplate" class="space-y-3 <%= (form.flexMode === 'raw' || form.flexMode === 'espa') ? 'hidden' : '' %>">
        <div class="grid md:grid-cols-2 gap-3">
          <div>
            <label class="label">หัวเรื่อง</label>
            <input name="annTitle" value="<%= form.annTitle || 'ประกาศวันหยุดบริษัท' %>" class="input">
          </div>
          <div>
            <label class="label">หมวด / ผู้ออกประกาศ</label>
            <input name="annCategory" value="<%= form.annCategory || 'ฝ่ายบุคคลและธุรการ' %>" class="input">
          </div>
        </div>
        <div>
          <label class="label">เนื้อหา</label>
          <textarea name="annBody" rows="3" class="input"><%= form.annBody || 'บริษัทกำหนดวันหยุดพิเศษเพิ่มเติมในเดือนสิงหาคม ขอให้ทุกฝ่ายวางแผนงานล่วงหน้า' %></textarea>
        </div>
        <div>
          <label class="label">รายการย่อย (บรรทัดละ 1 ข้อ)</label>
          <textarea name="annBullets" rows="3" class="input"><%= form.annBullets || 'วันจันทร์ที่ 10 สิงหาคม 2569 หยุดทำการ\nฝ่ายจัดส่งทำงานปกติ\nติดต่อ HR ต่อ 101' %></textarea>
        </div>
        <div class="grid md:grid-cols-2 gap-3">
          <div>
            <label class="label">ข้อความบนปุ่ม (ไม่ใส่ก็ได้)</label>
            <input name="annButtonLabel" value="<%= form.annButtonLabel || '' %>" class="input" placeholder="อ่านรายละเอียด">
          </div>
          <div>
            <label class="label">ลิงก์ปุ่ม (ต้องเป็น https)</label>
            <input name="annButtonUrl" value="<%= form.annButtonUrl || '' %>" class="input" placeholder="https://www.itgenius.co.th">
          </div>
        </div>
      </div>

      <div id="blockRaw" class="<%= form.flexMode === 'raw' ? '' : 'hidden' %>">
        <label class="label">Flex JSON (เฉพาะส่วน contents ของ bubble/carousel)</label>
        <textarea name="rawJson" rows="10" class="input font-mono text-xs" placeholder='{"type":"bubble", ...}'><%= form.rawJson || '' %></textarea>
        <p class="text-[11px] text-slate-400 mt-1">
          ออกแบบได้ที่ <a class="text-line" href="https://developers.line.biz/flex-simulator/" target="_blank">Flex Message Simulator</a>
          แล้วคัดลอกมาวางที่นี่
        </p>
      </div>

      <div>
        <label class="label">altText (ข้อความสำรองที่แสดงในรายการแชทและ notification)</label>
        <input name="altText" value="<%= form.altText || '' %>" class="input" placeholder="ประกาศจากฝ่ายบุคคล">
      </div>
    </div>

    <div class="flex gap-2 pt-2 border-t border-slate-100">
      <button name="action" value="preview" class="btn btn-ghost">ดูตัวอย่าง</button>
      <button name="action" value="dry" class="btn btn-dark">ทดสอบ dry-run</button>
      <button name="action" value="send" class="btn btn-primary">ส่งจริง</button>
    </div>
  </form>

  <div class="space-y-4">
    <% if (preview) { %>
      <div class="card p-5">
        <div class="card-title mb-2">ตัวอย่างข้อความที่จะส่ง</div>
        <% if (preview.kind === 'text') { %>
          <div class="bg-slate-100 rounded-xl p-4 text-sm whitespace-pre-wrap"><%= preview.text %></div>
        <% } else { %>
          <div class="text-xs text-slate-500 mb-1">altText: <%= preview.altText %></div>
          <pre class="bg-navy text-slate-100 rounded-xl p-4 text-[11px] overflow-x-auto max-h-96"><%= JSON.stringify(preview.contents, null, 2) %></pre>
          <p class="text-[11px] text-slate-400 mt-2">
            คัดลอก JSON ด้านบนไปวางใน Flex Message Simulator เพื่อดูหน้าตาจริงก่อนส่ง
          </p>
        <% } %>
      </div>
    <% } %>

    <div class="card overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-200 card-title">ประวัติการส่งล่าสุด</div>
      <!-- รายการแทนตาราง ด้วยเหตุผลเดียวกับการ์ด "การส่งข้อความล่าสุด" ในหน้าภาพรวม -->
      <div class="px-5 py-1">
        <% if (logs.length === 0) { %>
          <p class="text-center text-slate-400 py-6 text-sm">ยังไม่มีประวัติ</p>
        <% } %>
        <% logs.forEach(function (l) { %>
          <div class="log-row">
            <div class="log-time"><%= formatDateTime(l.created_at) %></div>
            <div class="log-main">
              <div class="log-text" title="<%= l.preview %>"><%= l.preview %></div>
              <div class="log-target"><%= l.target_name || l.target_id || l.target_type %></div>
              <% if (l.error) { %><div class="text-[10px] text-red-500 mt-1"><%= l.error %></div><% } %>
            </div>
            <span class="badge shrink-0 <%= l.status === 'sent' ? 'bg-emerald-100 text-emerald-700' : l.status === 'failed' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-600' %>"><%= l.status %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleKind() {
    const isFlex = document.querySelector('input[name=kind]:checked').value === 'flex'
    document.getElementById('blockText').classList.toggle('hidden', isFlex)
    document.getElementById('blockFlex').classList.toggle('hidden', !isFlex)
  }
  function toggleFlexMode() {
    const mode = document.getElementById('flexMode').value
    document.getElementById('blockRaw').classList.toggle('hidden', mode !== 'raw')
    document.getElementById('blockTemplate').classList.toggle('hidden', mode !== 'template')
    document.getElementById('blockEspa').classList.toggle('hidden', mode !== 'espa')
  }
  // -------------------------------------------------------------------------
  // ESPA: งานที่ทำบ่อย + เลขที่เอกสารอัตโนมัติ
  // -------------------------------------------------------------------------
  var ESPA_PRESETS = <%- JSON.stringify(espaPresets || {}) %>;

  var deptEl = document.getElementById('espaDept');
  var presetEl = document.getElementById('espaPreset');

  if (deptEl && presetEl) {
    // เติมรายการงานของแผนกที่เลือกลงใน dropdown
    function fillPresetOptions() {
      var list = ESPA_PRESETS[deptEl.value] || [];
      presetEl.innerHTML = '';
      var first = document.createElement('option');
      first.value = '';
      first.textContent = list.length
        ? '— เลือกเพื่อเติมข้อความให้อัตโนมัติ —'
        : '— แผนกนี้ยังไม่มีงานสำเร็จรูป —';
      presetEl.appendChild(first);
      list.forEach(function (p) {
        var o = document.createElement('option');
        o.value = p.id;
        o.textContent = p.label;
        presetEl.appendChild(o);
      });
    }

    function setVal(id, value) {
      var el = document.getElementById(id);
      if (el) el.value = value || '';
    }

    // เลือกงาน = เขียนทับ 5 ช่องนี้ทันที ไม่ถามก่อน
    // ตั้งใจให้เขียนทับ เพราะจุดประสงค์ของ preset คือไม่ต้องพิมพ์เอง
    // ถ้าพิมพ์ไปแล้วแล้วมาเลือก preset ทีหลัง ก็ยังแก้ต่อได้ตามปกติ
    presetEl.addEventListener('change', function () {
      var list = ESPA_PRESETS[deptEl.value] || [];
      var p = list.filter(function (x) { return x.id === presetEl.value; })[0];
      if (!p) return;
      setVal('espaTitle', p.title);
      setVal('espaAltText', p.title);
      setVal('espaMessage', p.message);
      setVal('espaStatus', p.status);
      setVal('espaOwner', p.owner);
      setVal('espaNote', p.note);
      // เติมวันเวลาปัจจุบันให้ด้วย เพราะเกือบทุกใบต้องใส่และมักเป็นเวลาที่กดส่ง
      setVal('espaDatetime', new Date().toLocaleString('th-TH', {
        day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
      }).replace(' น.', ''));
    });

    // เปลี่ยนแผนก = เปลี่ยนรายการงาน และบอกว่าเลขถัดไปของแผนกนี้จะเป็นอะไร
    deptEl.addEventListener('change', function () {
      fillPresetOptions();
      refreshRefHint();
    });
    fillPresetOptions();

    // --- เลขที่เอกสาร ---
    var refHint = document.getElementById('refHint');

    // ดูเฉย ๆ ไม่จองเลข จึงเรียกได้ทุกครั้งที่เปลี่ยนแผนกโดยไม่เปลืองเลข
    function refreshRefHint() {
      if (!refHint) return;
      fetch('/api/espa/peek-ref?department=' + encodeURIComponent(deptEl.value))
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.referenceNo) refHint.textContent = 'เว้นว่างไว้ ระบบจะออกเลข ' + d.referenceNo + ' ให้ตอนกดส่ง';
        })
        .catch(function () { refHint.textContent = ''; });
    }
    refreshRefHint();

    var btnRef = document.getElementById('btnNextRef');
    if (btnRef) {
      btnRef.addEventListener('click', function () {
        btnRef.disabled = true;
        fetch('/api/espa/next-ref', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ department: deptEl.value })
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d && d.referenceNo) {
              setVal('espaRef', d.referenceNo);
              if (refHint) refHint.textContent = 'จองเลขนี้แล้ว ถ้าไม่ได้ส่ง เลขนี้จะถูกข้ามไป';
            }
          })
          .catch(function () {
            if (refHint) refHint.textContent = 'ออกเลขไม่สำเร็จ ลองใหม่อีกครั้ง';
          })
          .then(function () { btnRef.disabled = false; });
      });
    }
  }

  // เปลี่ยน dropdown กลุ่มเป็นช่องกรอกอิสระเมื่อเลือกส่งหาผู้ใช้รายบุคคล
  document.getElementById('targetType').addEventListener('change', function (e) {
    const wrap = document.getElementById('targetSelect')
    if (e.target.value === 'group') return
    const input = document.createElement('input')
    input.name = 'targetId'
    input.className = 'input'
    input.placeholder = e.target.value === 'user' ? 'Uxxxxxxxx (userId)' : 'ไม่ต้องใส่สำหรับ broadcast'
    if (e.target.value === 'broadcast') input.disabled = true
    wrap.replaceWith(input)
  })
</script>

<%- include('partials/foot') %>
